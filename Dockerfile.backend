# Meeting Organizer Agent - Backend (FastAPI)
# Build context: project root
#   docker build -f Dockerfile.backend -t moa-backend .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# weasyprint needs cairo/pango; build-essential covers a few wheels without prebuilt ones
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        gdk-pixbuf-2.0-0 \
        libcairo2 \
        libffi-dev \
        libharfbuzz-subset0 \
        libjpeg62-turbo \
        libopenjp2-7 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install exactly the dependencies declared in pyproject.toml, without installing
# the project itself (the app lives in /app/backend and is exposed via PYTHONPATH).
COPY pyproject.toml /app/pyproject.toml
RUN python - <<'PY' > /tmp/requirements.txt
import pathlib, tomllib
data = tomllib.loads(pathlib.Path("/app/pyproject.toml").read_text(encoding="utf-8"))
for dep in data["project"]["dependencies"]:
    print(dep)
PY
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY alembic.ini /app/alembic.ini
COPY backend /app/backend
COPY data /app/data

ENV PYTHONPATH=/app/backend \
    HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
